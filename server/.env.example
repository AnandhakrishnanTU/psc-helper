# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Email via SMTP (for Gmail: smtp.gmail.com, port 465, and an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PSC Helper <your-address@gmail.com>

# Link used in notifications
APP_URL=http://localhost:5173
