# Copy to .env for local development. In production set these in Vercel > Project > Settings > Environment Variables.

# Public address of the app, used in email links
APP_URL=http://localhost:5173

# Supabase: Project > Connect > "Transaction pooler" URI (port 6543), with your database password filled in.
# Leave empty locally to use a built-in database stored in server/.pgdata
DATABASE_URL=

# Admin page (/admin). At least 12 characters, or admin is disabled.
ADMIN_PASSWORD=
# Where new-job and error notices are emailed
ADMIN_EMAIL=

# Secret for the scheduled check endpoints (any long random string; also used in supabase/cron.sql)
CRON_SECRET=

# Phone/browser notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Email via Brevo SMTP (free 300/day): Brevo > SMTP & API > SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=GovJoli <alerts@codemure.com>
