# Copy to .env for local development. In production set these in the hosting dashboard.

# Public address of the app, used in email links
APP_URL=http://localhost:5173

# Admin page (/admin). At least 12 characters, or admin is disabled.
ADMIN_PASSWORD=
# Where new-job and error notices are emailed
ADMIN_EMAIL=

# Phone/browser notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Email via SMTP. Brevo: smtp-relay.brevo.com port 587. Resend: smtp.resend.com port 465.
# Gmail (testing only): smtp.gmail.com port 465 with an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PSC Helper <alerts@example.com>

# Storage (defaults shown)
# DB_PATH=psc-helper.db
# BACKUP_DIR=backups
